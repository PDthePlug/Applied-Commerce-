# Applied Commerce runtime mode.
# Keep local until role-based authenticated acceptance is complete in the target environment.
# Set to "supabase" only when the environment is intentionally activated against its database.
NEXT_PUBLIC_APPLIED_COMMERCE_BACKEND_MODE=local

# Canonical active AC Supabase project: upvbxplswxhoqzbvgdxv.
# Values are intentionally blank in source control. Configure per environment in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public project reference metadata is also recorded in lib/backend/config.ts.
# Never put service-role keys or other server secrets in NEXT_PUBLIC_* variables.
